# Runtime: use Neon's pooled TLS URL in Vercel; local PostgreSQL also works.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cimessfruit?schema=public"
# Prisma CLI: Neon direct/unpooled TLS URL for migrations and inspection.
# Empty falls back to DATABASE_URL for local development.
DATABASE_URL_UNPOOLED=""
# Runtime only: limits apply to each independent application pool.
DB_POOL_MAX="3"
DB_CONNECTION_TIMEOUT_MS="5000"
DB_IDLE_TIMEOUT_MS="5000"
# SQL cancellation is SET LOCAL per transaction, compatible with transaction pooling.
DB_STATEMENT_TIMEOUT_MS="10000"
# Fallback client deadline must be larger than the SQL deadline.
DB_QUERY_TIMEOUT_MS="12000"
# Retains the previous Prisma interactive transaction duration default.
DB_TRANSACTION_TIMEOUT_MS="5000"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Development only: exact Expo Go callback shown in the mobile sign-in URL.
# MOBILE_DEV_CALLBACK_URL="exp://192.168.0.197:8081/--/auth/callback"
# Enable only when deployed behind a trusted reverse proxy.
# AUTH_TRUST_HOST=true
# Server-only. Use at least 32 random characters; never EXPO_PUBLIC_ or NEXT_PUBLIC_.
ADMIN_AUTHORIZATION_KEY=""

# Transactional recovery/verification email (verified sender required)
RESEND_API_KEY=""
MAIL_FROM=""

# Cloudinary product photo storage (Public)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 dispute evidence storage (Private)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_EVIDENCE_BUCKET="cimessfruit"
# Canonical API origin used for durable authenticated evidence links.
APP_URL="http://localhost:3000"

# Optional server-only Redis cache. Empty disables caching; no schema change needed.
# For Upstash, copy the TLS TCP URL (rediss://); REST variables alone are not used.
# Production requires rediss:// with a valid server TLS certificate.
# REDIS_URL="rediss://default:URL_ENCODED_PASSWORD@redis.example.com:6380/0"
REDIS_URL=""
# Use a distinct prefix for each app/environment sharing Redis.
# All API instances and maintenance/seed jobs for that environment must match.
REDIS_CACHE_PREFIX="cimessfruit:development"

# Server-only worker authorization; at least 16 random characters.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Never expose to mobile.
CRON_SECRET=""

# Push activation: owner applies push migration BEFORE deploying this schema/client.
NOTIFICATIONS_ENABLED="false"
PUSH_IOS_ENABLED="false"
# Canonical public HTTPS API origin, no path. Must match QStash signature subject.
NOTIFICATIONS_ORIGIN=""
QSTASH_TOKEN=""
# Copy the regional base URL from QStash console when applicable.
QSTASH_URL="https://qstash.upstash.io"
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Optional Expo enhanced push security access token; server-only.
EXPO_ACCESS_TOKEN=""

# Foreground SSE pilot. Enable only after migrations and Redis/provider verification.
SSE_ENABLED="false"
NEXT_PUBLIC_SSE_ENABLED="false"

# Resend signing secret for https://cimessfruit.cimessinvest.com/api/support (whsec_...).
RESEND_WEBHOOK_SECRET=""

# Receiving mailbox configured in Resend; also used as Reply-To for admin replies.
SUPPORT_EMAIL_ADDRESS="support@cimessfruit.cimessinvest.com"
