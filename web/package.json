{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:mobile": "next dev --hostname 0.0.0.0 --port 3001",
    "test:auth-live": "node scripts/auth-smoke.mjs",
    "db:seed": "tsx scripts/seed-catalogue.ts",
    "db:cleanup": "tsx scripts/maintenance.ts",
    "bench:orders": "tsx scripts/benchmark-orders.ts",
    "bench:inbox": "tsx scripts/benchmark-inbox.ts",
    "bench:email": "tsx scripts/benchmark-email.ts",
    "bench:delivery": "tsx scripts/benchmark-delivery.ts",
    "bench:pool": "tsx scripts/benchmark-pool.ts",
    "test:pool:local": "LOCAL_POOL_TESTS=1 node --import tsx --test --test-isolation=none tests/database-pool-local.test.ts",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@upstash/qstash": "^2.12.1",
    "@vercel/functions": "^3.10.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.8",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "svix": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
