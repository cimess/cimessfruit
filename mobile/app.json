{
  "expo": {
    "name": "CimessFruit",
    "slug": "cimess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.png",
    "scheme": "cimessfruit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/logo.png"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "android": {
      "package": "com.cimessfruit",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#128A3A",
          "image": "./assets/logo/logo.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach as evidence to your CimessFruit support messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1515973f-6170-4b36-9f8c-7dc657bbd955"
      }
    }
  }
}
