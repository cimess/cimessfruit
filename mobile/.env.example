# Development: LAN origin. Preview/production: public HTTPS origin in EAS variables.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Required for standalone Android builds; restrict to package + signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Enable only in a configured native build, not Expo Go.
EXPO_PUBLIC_PUSH_ENABLED="false"
EXPO_PUBLIC_IOS_PUSH_ENABLED="false"
EXPO_PUBLIC_EAS_PROJECT_ID=""
# EAS file environment variable path; do not put service-account credentials here.
# GOOGLE_SERVICES_JSON="/path/to/google-services.json"

EXPO_PUBLIC_SSE_ENABLED="false"

# Optional: Vercel Deployment Protection bypass secret (if Vercel Authentication is enabled on preview/dev)
# EXPO_PUBLIC_VERCEL_PROTECTION_BYPASS="your-bypass-secret"

# Opt-in local request counters; disabled by default.
EXPO_PUBLIC_REQUEST_METRICS_ENABLED="false"
