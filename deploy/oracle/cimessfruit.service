[Unit]
Description=CimessFruit API and web store
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cimessfruit
Group=cimessfruit
WorkingDirectory=/opt/cimessfruit/api
EnvironmentFile=/etc/cimessfruit/api.env
ExecStartPre=/usr/bin/node scripts/check-production.mjs
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
